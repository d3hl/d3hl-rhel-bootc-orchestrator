#cloud-config
# Rendered by Terraform templatefile(); uploaded as a Proxmox snippet and attached
# as the VM's cloud-init user-data. Values are injected, never hardcoded here.
users:
  - name: d3
    groups: [wheel]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}
disable_root: true

# Partition, format, and persistently mount the scsi1 data disk (/dev/sdb) as /home.
# overwrite: false is idempotent — survives reboots and re-runs without reformatting.
disk_setup:
  /dev/sdb:
    table_type: gpt
    layout: true
    overwrite: false

fs_setup:
  - label: home
    filesystem: xfs
    device: /dev/sdb1
    overwrite: false

mounts:
  - [LABEL=home, /home, xfs, defaults, 0, 2]

# Stateless cloud-init: install a systemd shutdown service that calls
# 'cloud-init clean --logs' before each power-off so the next boot is treated
# as a fresh instance. This ensures Proxmox-delivered cloud-init config
# (user keys, hostname, network) is always re-applied rather than baked in
# from first boot. All modules use overwrite:false / idempotent guards above.
write_files:
  - path: /etc/systemd/system/cloud-init-stateless.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Reset cloud-init state for stateless re-run on next boot
      DefaultDependencies=no
      Before=shutdown.target reboot.target halt.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/cloud-init clean --logs
      RemainAfterExit=yes

      [Install]
      WantedBy=shutdown.target reboot.target halt.target

runcmd:
  - systemctl enable cloud-init-stateless.service
